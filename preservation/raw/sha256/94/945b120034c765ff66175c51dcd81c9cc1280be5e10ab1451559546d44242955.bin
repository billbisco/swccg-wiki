<html><head><style type="text/css">[uib-typeahead-popup].dropdown-menu{display:block;}</style><style type="text/css">.uib-time input{width:50px;}</style><style type="text/css">.uib-datepicker .uib-title{width:100%;}.uib-day button,.uib-month button,.uib-year button{min-width:100%;}.uib-datepicker-popup.dropdown-menu{display:block;}.uib-button-bar{padding:10px 9px 2px;}</style><style type="text/css">.ng-animate.item:not(.left):not(.right){-webkit-transition:0s ease-in-out left;transition:0s ease-in-out left}</style><style type="text/css">@charset "UTF-8";[ng\:cloak],[ng-cloak],[data-ng-cloak],[x-ng-cloak],.ng-cloak,.x-ng-cloak,.ng-hide:not(.ng-hide-animate){display:none !important;}ng\:form{display:block;}.ng-animate-shim{visibility:hidden;}.ng-anchor{position:absolute;}</style>
    <meta charset="UTF-8">
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">

    <!-- Try to prevent caching -->
    <meta http-equiv="Cache-Control" content="no-store">
    <meta http-equiv="cache-control" content="max-age=0">
    <meta http-equiv="cache-control" content="no-cache">
    <meta http-equiv="expires" content="0">
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT">
    <meta http-equiv="pragma" content="no-cache">
    <meta http-equiv="Cache-Control" content="no-store">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Scomp Link Access</title>
  </head>

  <body>

    <!-- Third Party -->
    <script src="js/jquery-2.1.4.min.js"></script>
    <script src="js/angular.1.4.8.min.js"></script>
    <script src="js/select.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="ui-bootstrap-tpls-1.1.0.min.js.css"></script>
    <script src="js/angular-ui.min.js"></script>
    <script src="js/angular-sanitize.js"></script>

    <!-- Main App -->
    <script src="js/app.js"></script>
    <script src="js/CardSearchController.js"></script>
    <script src="js/CDFService.js"></script>
    <script src="js/ExportService.js"></script>
    <!--<script src="js/SWIPExportService.js"></script>-->
    <script src="js/SWIPService.js"></script>
    <script src="js/onLoadError.js"></script>
    <script src="js/onLoadSuccess.js"></script>
    <script src="js/outsideClick.js"></script>


    <!-- CSS -->
    <link rel="stylesheet" type="text/css" href="css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="css/cardSearch.css">
    <link rel="stylesheet" type="text/css" href="css/select.min.css">


    <!-- Content -->
    <div ng-app="cardSearchApp" ng-controller="CardSearchController" class="cs-main container-fluid ng-scope">


    <!--
    <button data-ng-click="exportLightCdf()">Export Light CDF</button>
    <button data-ng-click="exportDarkCdf()">Export Dark CDF</button>
    <button data-ng-click="exportSWIP()">Export SWIP</button>
    -->

      <div class="cs-title">
        <div class="cs-title-holder">
          <span>
            <img src="./scomp.png" class="cs-logo-image"> Scomp Link Access
          </span>
        </div>
      </div>
      <hr class="cs-title-divider">

      <!-- ngIf: data.selectedCard != null --><div data-ng-if="data.selectedCard != null" class="cs-card-preview-pane ng-scope" data-ng-click="hideCardData()" outside-click="hideCardData">

        <!-- Extra Card Data -->
        <!-- ngIf: data.selectedCard != null --><div data-ng-if="data.selectedCard != null" class="cs-extra-data ng-scope" data-ng-click="clickedCardData($event)">
          <div class="cs-extra-card-data-close" data-ng-click="hideCardData()">
            <i class="glyphicon glyphicon-remove"></i> 
          </div>
          <div class="cs-extra-card-data-title">
            Extra Card Data
          </div>
          <!-- ngIf: data.showExtraData --><div class="ng-scope" data-ng-if="data.showExtraData">
            <!-- ngIf: !hasExtraData(data.selectedCard) -->

            <!-- Pulls -->
            <!-- ngIf: data.selectedCard.pulls -->

            <!-- Pulled By -->
            <!-- ngIf: data.selectedCard.pulledBy --><div class="cs-extra-data-column ng-scope" data-ng-if="data.selectedCard.pulledBy">
              <div class="cs-extra-data-label">Pulled By:</div>
              <!-- ngRepeat: pulledBy in data.selectedCard.pulledBy track by $index --><div data-ng-repeat="pulledBy in data.selectedCard.pulledBy track by $index" class="ng-scope">
                <!-- ngIf: pulledBy.title -->
                <!-- ngIf: !pulledBy.title --><div data-ng-if="!pulledBy.title" class="ng-scope">
                  <a href="/?s=Skull" target="_blank" class="ng-binding">Skull</a>
                </div><!-- end ngIf: !pulledBy.title -->
              </div><!-- end ngRepeat: pulledBy in data.selectedCard.pulledBy track by $index -->
            </div><!-- end ngIf: data.selectedCard.pulledBy -->

            <!-- Counterpart -->
            <!-- ngIf: data.selectedCard.counterpart --><div class="cs-extra-data-column ng-scope" data-ng-if="data.selectedCard.counterpart">
              <div class="cs-extra-data-label">Counterpart:</div>
              <!-- ngIf: data.selectedCard.counterpart.title -->
              <!-- ngIf: !data.selectedCard.counterpart.title --><div data-ng-if="!data.selectedCard.counterpart.title" class="ng-scope">
                <a href="/?s=Stunning Leader" target="_blank" class="ng-binding">Stunning Leader</a>
              </div><!-- end ngIf: !data.selectedCard.counterpart.title -->
            </div><!-- end ngIf: data.selectedCard.counterpart -->

            <!-- Combo -->
            <!-- ngIf: data.selectedCard.combo --><div class="cs-extra-data-column ng-scope" data-ng-if="data.selectedCard.combo">
              <div class="cs-extra-data-label">Combo:</div>
              <!-- ngRepeat: combo in data.selectedCard.combo track by $index --><div data-ng-repeat="combo in data.selectedCard.combo track by $index" class="cs-combo-block ng-scope">
                <div ng-bind-html="combo | to_trusted" class="ng-binding">Blast The Door, Kid! + All My Urchins A good way to make your opponent lose 2 Force for nothing. (l000needles)</div>
              </div><!-- end ngRepeat: combo in data.selectedCard.combo track by $index -->
            </div><!-- end ngIf: data.selectedCard.combo -->
            
            <!-- Matching -->
            <!-- ngIf: data.selectedCard.matching -->

            <!-- Matching Weapon -->
            <!-- ngIf: data.selectedCard.matchingWeapon -->

            <!-- Canceled By -->
            <!-- ngIf: data.selectedCard.canceledBy --><div class="cs-extra-data-column ng-scope" data-ng-if="data.selectedCard.canceledBy">
              <div class="cs-extra-data-label">Canceled By:</div>
              <!-- ngRepeat: canceledBy in data.selectedCard.canceledBy track by $index --><div data-ng-repeat="canceledBy in data.selectedCard.canceledBy track by $index" class="ng-scope">
                <!-- ngIf: canceledBy.title -->
                <!-- ngIf: !canceledBy.title --><div data-ng-if="!canceledBy.title" class="ng-scope">
                  <a href="/?s=Blast Door Controls" target="_blank" class="ng-binding">Blast Door Controls</a>
                </div><!-- end ngIf: !canceledBy.title -->
              </div><!-- end ngRepeat: canceledBy in data.selectedCard.canceledBy track by $index -->
            </div><!-- end ngIf: data.selectedCard.canceledBy -->

            <!-- Cancels -->
            <!-- ngIf: data.selectedCard.cancels -->

            <!-- Abbreviation -->
            <!-- ngIf: data.selectedCard.abbreviations && data.selectedCard.abbreviations.length > 0 -->

            <!-- Underlying Cards -->
            <!-- ngIf: data.selectedCard.underlyingcardfor && data.selectedCard.underlyingcardfor.length > 0 --><div class="cs-extra-data-column ng-scope" data-ng-if="data.selectedCard.underlyingcardfor &amp;&amp; data.selectedCard.underlyingcardfor.length &gt; 0">
              <div class="cs-extra-data-label">Underlying Card For:</div>
              <!-- ngRepeat: vcard in data.selectedCard.underlyingcardfor track by $index --><div data-ng-repeat="vcard in data.selectedCard.underlyingcardfor track by $index" class="ng-scope">
                <!-- ngIf: vcard.title -->
                <!-- ngIf: !vcard.title --><div data-ng-if="!vcard.title" class="ng-scope">
                  <a href="/?s=Clone Trooper" target="_blank" class="ng-binding">Clone Trooper</a>
                </div><!-- end ngIf: !vcard.title -->
              </div><!-- end ngRepeat: vcard in data.selectedCard.underlyingcardfor track by $index -->
            </div><!-- end ngIf: data.selectedCard.underlyingcardfor && data.selectedCard.underlyingcardfor.length > 0 -->

            <!-- Personas -->
            <!-- ngIf: data.selectedCard.personas && data.selectedCard.personas.length > 0 -->


            <!-- Rulings -->
            <!-- ngIf: data.selectedCard.rulings -->

            <!-- Important Details -->
            <!-- ngIf: (data.selectedCard.front.type == 'Character') || data.selectedCard.front.characteristics || data.selectedCard.back.characteristics --><!-- / important details -->

          </div><!-- end ngIf: data.showExtraData -->

        </div><!-- end ngIf: data.selectedCard != null -->


        <!-- Text Card Display -->
        <!-- ngIf: data.textOnly || data.imageLoadFailure -->

        <!-- Image Display -->
        <!-- ngIf: !data.textOnly && !data.imageLoadFailure --><div data-ng-if="!data.textOnly &amp;&amp; !data.imageLoadFailure" class="cs-card-preview-overlay ng-scope">
          <div class="cs-card-preview-image">
            <!-- ngIf: data.selectedCard.links.length == 1 --><div data-ng-if="data.selectedCard.links.length == 1" class="ng-scope">
              <img class="cs-card-image img-responsive" align="right" ng-src="https://res.starwarsccg.org/cards/ANewHope-Light/large/blastthedoorkid.gif" on-load-error="onImageLoadError" on-load-success="onImageLoadSuccess" src="https://res.starwarsccg.org/cards/ANewHope-Light/large/blastthedoorkid.gif">
            </div><!-- end ngIf: data.selectedCard.links.length == 1 -->
            <!-- ngIf: data.selectedCard.links.length > 1 -->
          </div>
          <button class="cs-row-full-width button-hide-card-data" @click="hideCardData">
            Back to Search
          </button>
        </div><!-- end ngIf: !data.textOnly && !data.imageLoadFailure -->


      </div><!-- end ngIf: data.selectedCard != null -->


      <div class="row cs-row-full-width">

        <!-- Search Pane -->
        <div class=" col-md-3 cs-search-pane">

          <!-- Side -->
          <div class="cs-searchField cs-first-one">
            <div class="cs-searchLabel">Side</div>
            <select data-ng-model="search.side" class="cs-search-input ng-pristine ng-untouched ng-valid" data-ng-change="searchIfNotEmpty()">
              <option value="ALL">Any</option>
              <option value="LIGHT">Light</option>
              <option value="DARK">Dark</option>
            </select>
          </div>


          <!-- Type -->
          <div class="cs-searchField">
            <div class="cs-searchLabel">Type</div>
            <select data-ng-model="search.type" class="cs-search-input ng-pristine ng-untouched ng-valid" data-ng-change="searchIfNotEmpty()">
              <option value="ALL">Any</option>
              <option value="ADMIRALS_ORDER">Admiral's Order</option>
              <option value="CHARACTER">Character</option>
              <option value="CREATURE">Creature</option>
              <option value="DEFENSIVE_SHIELD">Defensive Shield</option>
              <option value="DEVICE">Device</option>
              <option value="EFFECT">Effect</option>
              <option value="EPIC_EVENT">Epic Event</option>
              <option value="INTERRUPT">Interrupt</option>
              <option value="JEDI_TEST">Jedi Test</option>
              <option value="LOCATION">Location</option>
              <option value="OBJECTIVE">Objective</option>
              <option value="PODRACER">Podracer</option>
              <option value="STARSHIP">Starship</option>
              <option value="VEHICLE">Vehicle</option>
              <option value="WEAPON">Weapon</option>
            </select>
          </div>

          <!-- Search Field -->
          <div class="cs-searchField">
            <div class="cs-searchLabel">Search In</div>
            <select data-ng-model="search.searchField" class="cs-search-input ng-pristine ng-untouched ng-valid" data-ng-change="searchIfNotEmpty()">
              <option value="ALL">Any</option>
              <option value="TITLE">Title / Abbreviation</option>
              <option value="GAMETEXT">Gametext</option>
              <option value="LORE">Lore</option>
            </select>
          </div>



          <!-- Search Text -->
          <div class="cs-searchField">
            <div class="cs-searchLabel">Search Text</div>
            <input data-ng-model="search.text" class="cs-search-input ng-pristine ng-untouched ng-valid" placeholder="Enter Search Text Here..." data-ng-keydown="$event.keyCode == 13 ? doSearch() : null">
          </div>


          <!-- Search Button -->
          <div class="cs-searchField cs-search-buttons">

            <button data-ng-click="clearSearch()" class="btn cs-card-search-button hyperstyle pull-left">Reset Search</button>
            <a href="#">
              <button data-ng-click="doSearch()" class="btn btn-primary cs-card-search-button pull-right">
                Search
              </button>
            </a>
            
            <div class="clearfix"></div>
            <!-- ngIf: data.matches.length > 0 --><a href="#results" id="results-link" data-ng-if="data.matches.length &gt; 0" class="ng-scope">Jump to search results</a><!-- end ngIf: data.matches.length > 0 -->
            <!-- <button data-ng-click="advancedSearchBuilder()" class="btn btn-primary cs-card-search-button">Advanced Search</button> -->
          </div>

          <!-- ngIf: data.cardFields.length > 0 --><div class="cs-advanced-panel ng-scope" data-ng-if="data.cardFields.length &gt; 0">

            <div class="cs-advanced-panel-title">
              Advanced Filters
            </div>



            <!-- Search Fields -->
            <div class="cs-searchLabel">Filter Field</div>
            <select ng-model="data.advancedField" class="form-control input-sm ng-pristine ng-untouched ng-valid" id="cs-advanced-field-name-dropdown">
              <!-- ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="abbreviations" class="ng-binding ng-scope">
                abbreviations
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="ability" class="ng-binding ng-scope">
                ability
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="armor" class="ng-binding ng-scope">
                armor
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="canceledBy" class="ng-binding ng-scope">
                canceledBy
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="cancels" class="ng-binding ng-scope">
                cancels
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="characteristics" class="ng-binding ng-scope">
                characteristics
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="combo" class="ng-binding ng-scope">
                combo
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="conceptBy" class="ng-binding ng-scope">
                conceptBy
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="counterpart" class="ng-binding ng-scope">
                counterpart
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="darkSideIcons" class="ng-binding ng-scope">
                darkSideIcons
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="deploy" class="ng-binding ng-scope">
                deploy
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="destiny" class="ng-binding ng-scope">
                destiny
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="destinyValues" class="ng-binding ng-scope">
                destinyValues
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="errataDate" class="ng-binding ng-scope">
                errataDate
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="errataNotes" class="ng-binding ng-scope">
                errataNotes
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="errataSymbol" class="ng-binding ng-scope">
                errataSymbol
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="extraText" class="ng-binding ng-scope">
                extraText
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="ferocity" class="ng-binding ng-scope">
                ferocity
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="forfeit" class="ng-binding ng-scope">
                forfeit
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="gametext" class="ng-binding ng-scope">
                gametext
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="hyperspeed" class="ng-binding ng-scope">
                hyperspeed
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="icons" class="ng-binding ng-scope">
                icons
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="landspeed" class="ng-binding ng-scope">
                landspeed
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="lightSideIcons" class="ng-binding ng-scope">
                lightSideIcons
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="lore" class="ng-binding ng-scope">
                lore
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="maneuver" class="ng-binding ng-scope">
                maneuver
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="matching" class="ng-binding ng-scope">
                matching
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="matchingWeapon" class="ng-binding ng-scope">
                matchingWeapon
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="parsec" class="ng-binding ng-scope">
                parsec
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="personas" class="ng-binding ng-scope">
                personas
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="politics" class="ng-binding ng-scope">
                politics
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="power" class="ng-binding ng-scope">
                power
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="printableSlipType" class="ng-binding ng-scope">
                printableSlipType
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="printableSlipUrl" class="ng-binding ng-scope">
                printableSlipUrl
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="pulledBy" class="ng-binding ng-scope">
                pulledBy
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="pulls" class="ng-binding ng-scope">
                pulls
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="rarity" class="ng-binding ng-scope">
                rarity
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="rulings" class="ng-binding ng-scope">
                rulings
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="set" class="ng-binding ng-scope">
                set
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="side" class="ng-binding ng-scope">
                side
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="subType" class="ng-binding ng-scope">
                subType
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="title" class="ng-binding ng-scope">
                title
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="type" class="ng-binding ng-scope">
                type
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="underlyingCardFor" class="ng-binding ng-scope">
                underlyingCardFor
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' --><option ng-repeat="fieldName in data.cardFields | orderBy:'toString()'" value="uniqueness" class="ng-binding ng-scope">
                uniqueness
              </option><!-- end ngRepeat: fieldName in data.cardFields | orderBy:'toString()' -->
            </select>

            <!-- Operator (contains, >, =, < etc) -->
            <select ng-options="operator.name as operator.name for operator in data.operators" ng-model="data.advancedOperator" class="form-control input-sm ng-pristine ng-untouched ng-valid"><option label="contains" value="string:contains" selected="selected">contains</option><option label="doesn't contain" value="string:doesn't contain">doesn't contain</option><option label="&gt;" value="string:&gt;">&gt;</option><option label="&lt;" value="string:&lt;">&lt;</option><option label="=" value="string:=">=</option><option label="&lt;=" value="string:&lt;=">&lt;=</option><option label="&gt;=" value="string:&gt;=">&gt;=</option><option label="not" value="string:not">not</option></select>

            <!-- Possible Values -->
            <div>
              <div class="cs-advanced-value ui-select-container ui-select-bootstrap dropdown ng-valid" ng-class="{open: $select.open}" ng-model="data.advancedValue" theme="bootstrap" on-select="addAdvancedCondition($select)" tagging="" reset-search-input="false" data-ng-keyup="updateAdvancedSearchText($event, $select)"><div class="ui-select-match" ng-hide="$select.open &amp;&amp; $select.searchEnabled" ng-disabled="$select.disabled" ng-class="{'btn-default-focus':$select.focus}" placeholder="Type or select..."><span tabindex="-1" class="btn btn-default form-control ui-select-toggle" aria-label="Select box activate" ng-disabled="$select.disabled" ng-click="$select.activate()" style="outline: 0;"><span ng-show="$select.isEmpty()" class="ui-select-placeholder text-muted ng-binding">Type or select...</span> <span ng-hide="$select.isEmpty()" class="ui-select-match-text pull-left ng-hide" ng-class="{'ui-select-allow-clear': $select.allowClear &amp;&amp; !$select.isEmpty()}" ng-transclude=""><span class="ng-binding ng-scope"></span></span> <i class="caret pull-right" ng-click="$select.toggle($event)"></i> <a ng-show="$select.allowClear &amp;&amp; !$select.isEmpty() &amp;&amp; ($select.disabled !== true)" aria-label="Select box clear" style="margin-right: 10px" ng-click="$select.clear($event)" class="btn btn-xs btn-link pull-right ng-hide"><i class="glyphicon glyphicon-remove" aria-hidden="true"></i></a></span></div><span ng-show="$select.open &amp;&amp; $select.refreshing &amp;&amp; $select.spinnerEnabled" class="ui-select-refreshing glyphicon-refresh ui-select-spin ng-hide"></span> <input type="search" autocomplete="off" tabindex="-1" aria-expanded="true" aria-label="Select box" aria-owns="ui-select-choices-0" class="form-control ui-select-search ng-pristine ng-untouched ng-valid ng-hide" ng-class="{ 'ui-select-search-hidden' : !$select.searchEnabled }" placeholder="Type or select..." ng-model="$select.search" ng-show="$select.open"><ul class="ui-select-choices ui-select-choices-content ui-select-dropdown dropdown-menu ng-hide" ng-show="$select.open &amp;&amp; $select.items.length &gt; 0" repeat="possibleValue in data.cardValueMap[data.advancedField] | orderBy:'toString()' | filter: $select.search"><li class="ui-select-choices-group" id="ui-select-choices-0"><div class="divider ng-hide" ng-show="$select.isGrouped &amp;&amp; $index &gt; 0"></div><div ng-show="$select.isGrouped" class="ui-select-choices-group-label dropdown-header ng-binding ng-hide" ng-bind="$group.name"></div><!-- ngRepeat: possibleValue in $select.items --></li></ul><div class="ui-select-no-choice"></div><ui-select-single></ui-select-single><input ng-disabled="$select.disabled" class="ui-select-focusser ui-select-offscreen ng-scope" type="text" id="focusser-0" aria-label="Select box focus" aria-haspopup="true" role="button"></div>
            </div>

            <div class="cs-add-filter-type">
              <label class="cs-filter-radio"><input type="radio" ng-model="data.filterAddMode" value="AND" class="ng-pristine ng-untouched ng-valid" name="9"> AND</label>
              <label class="cs-filter-radio"><input type="radio" ng-model="data.filterAddMode" value="OR" class="ng-pristine ng-untouched ng-valid" name="10"> OR</label>
              <label class="cs-filter-radio"><input type="radio" ng-model="data.filterAddMode" value="NOT" class="ng-pristine ng-untouched ng-valid" name="11"> NOT</label>
              <button class="btn btn-primary cs-card-search-button cs-advanced-buttons-small cs-add-filter-button" data-ng-click="addAdvancedCondition()">ADD</button>
              <div class="clearfix"></div>
            </div>

            <hr class="cs-hr-skinny">

            <div class="cs-current-filter-text">
              Current Filter:
            </div>
            <!-- ngIf: data.advancedConditions.length == 0 --><div data-ng-if="data.advancedConditions.length == 0" class="cs-current-filter-none ng-scope">
              None
            </div><!-- end ngIf: data.advancedConditions.length == 0 -->
            <!-- ngIf: data.advancedConditions.length > 0 -->
            <!-- ngIf: data.advancedConditions.length > 0 -->

            <label style="margin-top: 2em">Text-Only Display <input type="checkbox" name="checkbox" ng-model="data.textOnly" class="ng-pristine ng-untouched ng-valid"></label>
            <div></div>
            <label style="margin-top: 0.5em">Include Legacy Cards <input type="checkbox" name="checkbox" ng-model="data.shouldLoadLegacy" data-ng-click="toggleLegacyCards()" class="ng-pristine ng-untouched ng-valid"></label>

            <div style="font-size: 0.75em; margin-top: 1em; margin-bottom: 1em;">Version 2.0.3</div>
          </div><!-- end ngIf: data.cardFields.length > 0 -->

          <!-- Preview Mode -->
