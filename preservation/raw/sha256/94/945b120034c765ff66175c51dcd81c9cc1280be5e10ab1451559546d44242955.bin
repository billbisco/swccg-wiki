        <!-- Results Pane -->
        <div class="col-xs-8 col-md-9 cs-search-results-pane table-responsive" id="results">
          <!-- <div class="cs-search-results-label">Search Results</div> -->
          <!-- ngIf: data.loadingLight || data.loadingDark --><!-- ngIf: !data.loadingLight && !data.loadingDark && !data.performedSearch --><!-- ngIf: !data.loadingLight && !data.loadingDark && data.noResultsFound --><!-- ngIf: data.matches.length > 0 --><div class="cs-result-count ng-binding ng-scope" data-ng-if="data.matches.length &gt; 0">
            Match Count: 1
          </div><!-- end ngIf: data.matches.length > 0 --><table>
            <tbody><tr class="row cs-search-results-header">
            <th class="col-xs-4 cs-colored-column cs-color-1">
              Card Name
            </th>
            <th class="col-xs-1 cs-color-2">
              Side
            </th>
            <th class="col-xs-1 cs-colored-column cs-color-1">
              Set
            </th>
            <th class="col-xs-1 cs-color-2">
              Type
            </th>
            <th class="col-xs-3 cs-colored-column cs-color-1">
              Sub Type
            </th>
            <th class="col-xs-1 cs-color-2">
              Rare
            </th>
            <th class="col-xs-1 cs-colored-column cs-color-1">
              Destiny
            </th>
          </tr>

          

          

          

          <!-- ngRepeat: card in data.matches track by $index --><tr class="row cs-card-result ng-scope cs-card-result-selected" data-ng-repeat="card in data.matches track by $index" data-ng-class="{'cs-card-result-selected': card == data.lastSelectedCard}">
            <td class="col-xs-4 cs-link cs-colored-column cs-color-1 ng-binding" data-ng-click="selectCard(card, $event)">
              Blast The Door, Kid!
            </td>
            <td class="col-xs-1 cs-color-2 ng-binding">
              Light
            </td>
            <td class="col-xs-1 cs-colored-column cs-color-1 ng-binding">
              ANH
            </td>
            <td class="col-xs-1 cs-color-2 ng-binding">
              Interrupt
            </td>
            <td class="col-xs-3 cs-colored-column cs-color-1">
              <div class="ng-binding">
                Lost
              </div>
            </td>
            <td class="col-xs-1 cs-color-2 ng-binding">
              C2
            </td>
            <td class="col-xs-1 cs-colored-column cs-color-1 ng-binding">
              4
            </td>
          </tr><!-- end ngRepeat: card in data.matches track by $index -->

          
          </tbody></table>

        </div>

      </div>

    </div>
