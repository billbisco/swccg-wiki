<style media="screen">/* inlined from https://forum.starwarsccg.org/ext/dmzx/filedownload/styles/prosilver/theme/filedownload.css?assets_version=147 */
dl.files {
	font-family: Verdana, Arial, Helvetica, sans-serif;
	display: block;
}

dl.files dt {
	text-transform: none;
	margin: 0;
	padding: 0;
	font-weight: bold;
	font-family: Verdana, Arial, Helvetica, sans-serif;
}

