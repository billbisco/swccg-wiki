def main():
 p=argparse.ArgumentParser();p.add_argument('--end',type=int);a=p.parse_args();HERE.mkdir(exist_ok=True)
 site=api({'action':'query','meta':'siteinfo','siprop':'namespaces|statistics'})['query'];atomic(HERE/'siteinfo-before.json',site)
 started=now();target=HERE/'wiki-current.xml.gz';errpath=HERE/'export-stderr.txt'
 args=['ssh','-o','BatchMode=yes','-o','ConnectTimeout=15','gemp','docker exec -u www-data swccg_wiki nice -n 10 php maintenance/run.php dumpBackup --current --quiet'+(' --end '+str(a.end) if a.end else '')]
 n=0;tick=time.monotonic()
 with errpath.open('wb') as err:
  proc=subprocess.Popen(args,stdout=subprocess.PIPE,stderr=err)
  try:
   with target.open('wb') as output,gzip.GzipFile(filename='',mode='wb',fileobj=output,mtime=0,compresslevel=6) as gz:
    while b:=proc.stdout.read(1024**2):
     if shutil.disk_usage(HERE).free<20*1024**3:raise RuntimeError('PC20GiB free reserve reached')
     n+=len(b)
     if n>2*1024**3:raise RuntimeError('Explicit2GiB XML budget reached')
     gz.write(b)
     if time.monotonic()-tick>10:atomic(HERE/'progress.json',{'phase':'streaming','xml_bytes':n,'compressed_bytes':output.tell(),'at':now()});tick=time.monotonic()
   if proc.wait(timeout=60):raise RuntimeError('Remote public export failed; inspect stderr')
  except BaseException:proc.kill();proc.wait();raise
 finished=now();atomic(HERE/'progress.json',{'phase':'parsing','xml_bytes':n,'at':now()})
 parsed=parse(target,HERE/'pages-manifest.jsonl',HERE/'pages.sqlite');verified=restore(target,HERE/'pages-manifest.jsonl');sha,size=digest(target)
 parts=[]
 if size>90*1024**2:
  with target.open('rb') as f:
   offset=0;i=0
   while b:=f.read(90*1024**2):
    part=HERE/f'wiki-current.xml.gz.part-{i:03d}';part.write_bytes(b);parts.append({'path':part.name,'index':i,'offset':offset,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()});offset+=len(b);i+=1
 else:parts=[{'path':target.name,'index':0,'offset':0,'bytes':size,'sha256':sha}]
 atomic(HERE/'export-receipt.json',{'schema_version':1,'source':'MediaWiki public dumpBackup --current','started_at':started,'finished_at':finished,'cutoff_semantics':'Export interval; concurrent updates require closing delta reconciliation. Not a single-instant snapshot.','archive_org_requests':0,'restart_or_live_mutation':False,'xml_bytes':n,'gzip_sha256':sha,'gzip_bytes':size,'parts':parts,**parsed,'local_independent_restore':verified})
 print(json.dumps({'status':'complete',**parsed,**verified,'gzip_bytes':size,'path':str(target)},indent=2),flush=True)
if __name__=='__main__':main()
