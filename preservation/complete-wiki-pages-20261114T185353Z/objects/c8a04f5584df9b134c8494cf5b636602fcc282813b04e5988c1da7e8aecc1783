from __future__ import annotations
import argparse,collections,datetime,gzip,hashlib,json,os,shutil,sqlite3,subprocess,time,urllib.parse,urllib.request,xml.etree.ElementTree as ET
from pathlib import Path
HERE=Path(__file__).resolve().parent
API='https://wiki.swccg.com/api.php'
NS='{http://www.mediawiki.org/xml/export-0.11/}'
def now():return datetime.datetime.now(datetime.timezone.utc).isoformat()
def atomic(path,data):
 t=path.with_suffix(path.suffix+'.tmp');t.write_text(json.dumps(data,indent=2)+'\n',encoding='utf8');os.replace(t,path)
def api(params):
 params={'format':'json','formatversion':2,**params};u=API+'?'+urllib.parse.urlencode(params)
 r=urllib.request.urlopen(urllib.request.Request(u,headers={'User-Agent':'SWCCG-IndependentBackupAudit/1.0'}),timeout=90)
 with r:j=json.load(r)
 if 'error' in j:raise RuntimeError(j['error'])
 return j
def digest(path):
 h=hashlib.sha256();n=0
 with path.open('rb') as f:
  while b:=f.read(1024**2):h.update(b);n+=len(b)
 return h.hexdigest(),n
def parse(source,manifest,dbpath):
 db=sqlite3.connect(dbpath);db.execute('CREATE TABLE pages(page_id INTEGER PRIMARY KEY,title TEXT UNIQUE,namespace INTEGER,revision_id INTEGER,timestamp TEXT,model TEXT,bytes INTEGER,sha1 TEXT,sha256 TEXT,text_deleted INTEGER)')
 counts=collections.Counter();total=0;bad=[];last=0
 with gzip.open(source,'rb') as f,manifest.open('w',encoding='utf8',newline='\n') as out:
  for event,e in ET.iterparse(f,events=('end',)):
   if e.tag!=NS+'page':continue
   pid=int(e.findtext(NS+'id'));title=e.findtext(NS+'title');ns=int(e.findtext(NS+'ns'));rev=e.find(NS+'revision')
   if rev is None:raise RuntimeError('Page has no public revision: '+str(pid))
   rid=int(rev.findtext(NS+'id'));stamp=rev.findtext(NS+'timestamp');model=rev.findtext(NS+'model');text=rev.find(NS+'text')
   if text is None:raise RuntimeError('Page has no main text: '+str(pid))
   hidden=int('deleted' in text.attrib);raw=(text.text or '').encode('utf8');sha1=hashlib.sha1(raw).hexdigest();sha256=hashlib.sha256(raw).hexdigest();declared=text.get('sha1',rev.findtext(NS+'sha1',''));expected=int(text.get('bytes',len(raw)))
   if not hidden and (expected!=len(raw) or (declared and int(declared,36)!=int(sha1,16))):bad.append(pid)
   row={'page_id':pid,'title':title,'namespace':ns,'revision_id':rid,'timestamp':stamp,'model':model,'bytes':len(raw),'sha1':sha1,'sha256':sha256,'text_deleted':hidden}
   db.execute('INSERT INTO pages VALUES(?,?,?,?,?,?,?,?,?,?)',tuple(row.values()));out.write(json.dumps(row,ensure_ascii=False,separators=(',',':'))+'\n');counts[str(ns)]+=1;total+=len(raw);last+=1;e.clear()
   if last%10000==0:db.commit();atomic(HERE/'progress.json',{'phase':'parsing','pages':last,'bytes':total,'at':now()})
 db.commit();db.close()
 if bad:raise RuntimeError('XML text size/SHA1 mismatch pages '+str(bad[:20]))
 return {'pages':last,'text_bytes':total,'namespace_counts':dict(counts),'sha1_size_failures':len(bad)}
def restore(source,manifest):
 n=0;h=hashlib.sha256()
 with gzip.open(source,'rb') as f,manifest.open(encoding='utf8') as m:
  for event,e in ET.iterparse(f,events=('end',)):
   if e.tag!=NS+'page':continue
   row=json.loads(next(m));rev=e.find(NS+'revision');text=rev.find(NS+'text');raw=(text.text or '').encode('utf8')
   if (int(e.findtext(NS+'id'))!=row['page_id'] or int(rev.findtext(NS+'id'))!=row['revision_id'] or len(raw)!=row['bytes'] or hashlib.sha256(raw).hexdigest()!=row['sha256']):raise RuntimeError('Independent restore mismatch '+str(row['page_id']))
   n+=1;h.update(bytes.fromhex(row['sha256']));e.clear()
  if m.read().strip():raise RuntimeError('Manifest trailing rows')
