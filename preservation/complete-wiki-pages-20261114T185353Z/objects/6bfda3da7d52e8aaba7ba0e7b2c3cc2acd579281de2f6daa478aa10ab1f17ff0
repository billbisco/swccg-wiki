import datetime,gzip,hashlib,json,os,sqlite3,subprocess,time,xml.etree.ElementTree as ET
from pathlib import Path
import export_current as e
HERE=Path(__file__).resolve().parent
NS=e.NS
def parse_stub(source):
 rows={}
 with gzip.open(source,'rb') as f:
  for event,page in ET.iterparse(f,events=('end',)):
   if page.tag!=NS+'page':continue
   rev=page.find(NS+'revision');text=rev.find(NS+'text');pid=int(page.findtext(NS+'id'));sha=text.get('sha1',rev.findtext(NS+'sha1',''))
   row={'page_id':pid,'title':page.findtext(NS+'title'),'namespace':int(page.findtext(NS+'ns')),'revision_id':int(rev.findtext(NS+'id')),'timestamp':rev.findtext(NS+'timestamp'),'model':rev.findtext(NS+'model'),'bytes':int(text.get('bytes','0')),'sha1':f'{int(sha,36):040x}' if sha else None,'text_deleted':int('deleted' in text.attrib)}
   if pid in rows:raise RuntimeError('Duplicate target page ID')
   rows[pid]=row;page.clear()
