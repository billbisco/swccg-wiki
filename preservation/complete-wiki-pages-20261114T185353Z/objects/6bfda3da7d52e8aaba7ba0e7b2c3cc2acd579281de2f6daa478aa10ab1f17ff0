def collect_stub():
 target=HERE/'closing-current-stub.xml.gz';started=e.now()
 with (HERE/'closing-export-stderr.txt').open('wb') as err,target.open('wb') as out,gzip.GzipFile(filename='',mode='wb',fileobj=out,mtime=0) as gz:
  p=subprocess.Popen(['ssh','-o','BatchMode=yes','-o','ConnectTimeout=15','gemp','docker exec -u www-data swccg_wiki nice -n 10 php maintenance/run.php dumpBackup --current --stub --quiet'],stdout=subprocess.PIPE,stderr=err)
  try:
   while b:=p.stdout.read(1024**2):gz.write(b)
   if p.wait(timeout=60):raise RuntimeError('Closing public metadata export failed')
  except BaseException:p.kill();p.wait();raise
